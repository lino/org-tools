# org-tools configuration example.
# Copy to .org-tools.toml at your workspace root (or ~/.config/org-tools/config.toml).
# Defaults match standard Emacs Org-mode behavior when omitted.

[format]
# Remove trailing whitespace from non-protected lines (F001, default: true).
trailing_whitespace = true

# Collapse consecutive blank lines (F002, default: false, matching Emacs).
blank_lines = false
max_consecutive_blank_lines = 1

# Enforce blank lines before headings (F003, default: false, matching Emacs).
heading_blank_lines = false
heading_blank_lines_before = 1

# Align Org pipe table columns and separator rows (F004, default: true).
table_format = true

# Align property values within :PROPERTIES: drawers (F005, default: true).
property_drawer_align = true

[lint]
# Disable rules by ID or kebab-case name (e.g., ["W001", "heading-level-gap"]).
disabled_rules = []
# Explicitly enable opt-in hygiene rules (e.g., ["W038", "W039", "I008"]).
enable = []
# Link & duplicate :ID: resolution boundary: "vault" (default), "roam-dir", "dir", or "file".
id_scope = "vault"

[lint.zettel]
# Forbid active TODO keywords and checklists inside permanent notes (W038, default: false).
forbid_tasks = false

[lint.authoring]
# Forbid #+DATE: and #+AUTHOR: boilerplate file headers (W039, default: false).
forbid_ephemeral_headers = false
# Flag table cells exceeding this character length when set (I008, e.g., 120).
# max_table_cell_chars = 120

[agenda]
# Lead-time warning window in days for DEADLINE: timestamps without an explicit -Nd suffix (default: 14).
deadline_warning_days = 14

[todo]
# Additive fallback #+TODO: sequences used when an .org file omits its own #+TODO: header.
sequences = ["TODO(t) NEXT(n) WAITING(w) | DONE(d) CANCELLED(c)"]
todo = ["TODO", "NEXT", "WAITING"]
done = ["DONE", "CANCELLED"]

[roam]
# Default target vault name among [roam.directories] when --roam-dir is omitted.
default_directory = "work"
# Relative subdirectories for GTD, Zettelkasten, fleeting, and daily journal notes.
gtd_subdir = "gtd"
zettel_subdir = "zettel"
fleeting_subdir = "fleeting"
daily_subdir = "daily"
# Optional interactive capture editor override (falls back to $VISUAL, $EDITOR, then vi).
# editor = "nvim"
# Append a timestamped link under * Captured today in daily/YYYY-MM-DD.org on capture.
log_to_daily = false

[roam.directories]
# Named multi-vault org-roam v2 directories (supports ~/, $HOME/, and config-relative paths).
work = "~/org/work"
private = "~/org/private"

[capture.templates.inbox]
description = "Quick GTD inbox task"
keys = "i"
kind = "entry"
target = "gtd/inbox.org"
target_heading = "* Inbox"
properties = { CAPTURED_AT = "${timestamp_inactive}" }
body = "${body}"

[capture.templates.zettel]
description = "Permanent Zettelkasten concept note"
keys = "z"
kind = "file"
target = "zettel/${slug}.org"
roam_type = "concept"
body = "* Thesis\n${body}\n\n* Core Concept\n\n* Context & Significance\n\n* Related Concepts & Links\n\n* Open Questions & Folgezettel\n"

[projects.payments-api]
description = "Core payments REST service"
forge = "github.com/acme/payments-api"

[landscapes.billing-platform]
description = "Billing and settlement services"
projects = ["payments-api"]
forges = ["github.com/acme/billing-*"]
includes = ["platform-core"]
