# org-tools configuration example.
# Copy to .org-tools.toml to use.
# Defaults match Emacs org-mode behavior.

[format]
# Remove trailing whitespace from all lines (default: true).
trailing_whitespace = true

# Collapse consecutive blank lines (default: false, matching Emacs).
blank_lines = false
max_consecutive_blank_lines = 1

# Enforce blank lines before headings (default: false, matching Emacs).
heading_blank_lines = false
heading_blank_lines_before = 1

# Align table columns and normalize separators (default: true).
table_format = true

# Align property values within PROPERTIES drawers (default: true).
property_drawer_align = true

[lint]
# Disable rules by name or ID. Examples:
# disabled_rules = ["W001", "heading-level-gap"]
disabled_rules = []

[agenda]
# Lead-time warning window in days for deadlines without explicit -Nd warning suffix (default: 14).
deadline_warning_days = 14

[todo]
# Fallback active (incomplete) and completed (done) TODO state keywords.
active = ["TODO", "NEXT", "WAITING"]
done = ["DONE", "CANCELLED"]

# Additive TODO state sequences with pipe separator.
sequences = ["TODO NEXT WAITING | DONE CANCELLED"]

[roam]
# Default target vault name among configured roam directories.
default_directory = "work"

# Relative subdirectories for GTD, Zettelkasten, fleeting, and daily notes.
gtd_subdir = "gtd"
zettel_subdir = "zettel"
fleeting_subdir = "fleeting"
daily_subdir = "daily"

# Whether captures append an audit log to today's daily journal note.
log_to_daily = false

[roam.directories]
# Multi-directory org-roam v2 vault roots.
work = "~/org/work"
personal = "~/org/personal"

[capture.templates.inbox]
# Quick task filed into GTD inbox.
description = "Quick inbox task"
target_file = "gtd/inbox.org"
target_heading = "Tasks"
template = "* TODO %?\n:PROPERTIES:\n:CREATED: %U\n:END:\n"

[capture.templates.zettel]
# Permanent Zettelkasten concept note.
description = "Permanent concept note"
target_file = "zettel/%<%Y%m%d%H%M%S>-${slug}.org"
template = ":PROPERTIES:\n:ID: ${id}\n:TYPE: zettel\n:END:\n#+title: ${title}\n#+filetags: :zettel:\n\n* Core Concept\n\n%?\n"
